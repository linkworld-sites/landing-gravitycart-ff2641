13:T659,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How does the wheel-to-ski conversion work on the Gravity Cart Sport?","acceptedAnswer":{"@type":"Answer","text":"The GC-SPORT-01 chassis mounts its terrain interface at the same certified attachment points year-round. Swapping to winter use means releasing the wheel assembly and engaging the Ski Assembly Kit (GC-SKI-200) — a tool-free binding, no separate frame."}},{"@type":"Question","name":"What terrain and grade is the ski conversion rated for?","acceptedAnswer":{"@type":"Answer","text":"The GC-SKI-200 ski assembly is 780mm in length and rated to a 25% descent grade on packed snow, fitted to the GC-SPORT-01 chassis."}},{"@type":"Question","name":"What braking hardware does the Gravity Cart Sport use?","acceptedAnswer":{"@type":"Answer","text":"The Shimano Dual Brake Kit (GC-BRK-180) is a hydraulic dual-disc set with 180mm front and rear rotors, tested against the ECE R100 braking standard."}},{"@type":"Question","name":"What is the load rating of the certified chassis?","acceptedAnswer":{"@type":"Answer","text":"The GC-SPORT-01 chassis is rated to 120kg, with certified wheel and ski assemblies included, engineered for pavement, gravel and packed snow."}},{"@type":"Question","name":"Is the Gravity Cart Sport CE and ISO compliant?","acceptedAnswer":{"@type":"Answer","text":"Yes. The Gravity Cart Sport is independently tested and documented against ECE 2006/42/EG, ISO EN 12100 and ISO EN 4210 — the same category of machinery and safety directives that govern the automotive and machinery industries."}}]}8:["$","main",null,{"className":"mx-auto min-h-screen max-w-3xl px-6 py-24","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BlogPosting\",\"headline\":\"How a Gravity-Powered Descent Cart Converts Between Wheels and Skis\",\"description\":\"The engineering behind the GC-SPORT-01 gravity-powered descent cart: a certified chassis, tool-free ski conversion, and an ECE R100-tested Shimano dual-disc brake.\",\"datePublished\":\"2026-09-02\",\"url\":\"https://1bf88dc5.run.linkworld.ai/blog/2026-09-02-gravity-powered-descent-carts\",\"author\":{\"@type\":\"Organization\",\"name\":\"GravityCart\"}}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Product\",\"sku\":\"GC-SPORT-01\",\"name\":\"Gravity Cart Sport\",\"description\":\"The flagship convertible chassis. Certified wheel and ski assemblies included — one machine, engineered for pavement, gravel and packed snow.\",\"url\":\"https://1bf88dc5.run.linkworld.ai/product\",\"additionalProperty\":[{\"@type\":\"PropertyValue\",\"name\":\"Rated load\",\"value\":\"120kg\"},{\"@type\":\"PropertyValue\",\"name\":\"Fork material\",\"value\":\"Stainless steel fork\"},{\"@type\":\"PropertyValue\",\"name\":\"Brakes\",\"value\":\"Shimano dual disc brakes\"},{\"@type\":\"PropertyValue\",\"name\":\"Certifications\",\"value\":\"CE, ISO\"}],\"offers\":{\"@type\":\"Offer\",\"priceCurrency\":\"EUR\",\"price\":\"2890.00\",\"availability\":\"https://schema.org/InStock\",\"url\":\"https://1bf88dc5.run.linkworld.ai/product\"}}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$13"}}],["$","$L14",null,{"href":"/blog","className":"underline opacity-70","children":"← All posts"}],"$L15","$L16","$L17","$L18"]}]
